{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm run sidecar:ensure-ffmpeg && pnpm run sidecar:ensure-vc-redist && pnpm dev",
    "beforeBuildCommand": "pnpm run sidecar:ensure-ffmpeg && pnpm run sidecar:ensure-vc-redist && pnpm build"
  },
  "bundle": {
    "resources": [
      "windows/resources/vc_redist.x64.exe"
    ],
    "externalBin": [
      "../sidecar/ffmpeg/dist/ffmpeg",
      "../sidecar/ffmpeg/dist/ffprobe",
      "../sidecar/ffmpeg/dist/ffmpeg.exe",
      "../sidecar/ffmpeg/dist/ffprobe.exe"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/smart-installer-hooks.nsh"
      }
    }
  }
}
